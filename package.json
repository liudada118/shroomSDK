{
  "name": "shroom-backend-sdk",
  "version": "0.2.0",
  "description": "Standalone SDK for Shroom backend HTTP/WebSocket integration and local serial sensor experiments.",
  "main": "index.js",
  "type": "commonjs",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",

    "./renderers": "./UI/frontend/renderers/index.js",
    "./renderers/numMatrix": "./UI/frontend/renderers/numMatrix/react/NumMatrixRenderer.jsx",
    "./renderers/pointGrid": "./UI/frontend/renderers/pointGrid/react/PointGridRenderer.jsx",
    "./renderers/handPoints": "./UI/frontend/renderers/handPoints/react/HandPointsRenderer.jsx",
    "./renderers/webglHeatmap": "./UI/frontend/renderers/webglHeatmap/react/WebglHeatmapRenderer.jsx",
    "./renderers/blobHeatmap": "./UI/frontend/renderers/blobHeatmap/react/BlobHeatmapRenderer.jsx",
    "./renderers/numMatrix/core": "./UI/frontend/renderers/numMatrix/core/index.js",
    "./renderers/pointGrid/core": "./UI/frontend/renderers/pointGrid/core/index.js",
    "./renderers/handPoints/core": "./UI/frontend/renderers/handPoints/core/index.js",
    "./renderers/webglHeatmap/core": "./UI/frontend/renderers/webglHeatmap/core/index.js",
    "./renderers/blobHeatmap/core": "./UI/frontend/renderers/blobHeatmap/core/index.js",

    "./core": "./UI/frontend/core/index.js",
    "./core/*": "./UI/frontend/core/*",
    "./frontend": "./UI/frontend/index.js",
    "./styles/*": "./UI/frontend/styles/*",

    "./qxui": "./UI/qxui/index.js",
    "./shroomui": "./UI/shroomui/index.js",
    "./render": {
      "types": "./UI/render/index.d.ts",
      "default": "./UI/render/index.js"
    },

    "./UI": "./UI/index.js",
    "./UI/qxui": "./UI/qxui/index.js",
    "./UI/shroomui": "./UI/shroomui/index.js",
    "./UI/render": {
      "types": "./UI/render/index.d.ts",
      "default": "./UI/render/index.js"
    },
    "./UI/frontend": "./UI/frontend/index.js",
    "./UI/frontend/core": "./UI/frontend/core/index.js",
    "./UI/frontend/renderers": "./UI/frontend/renderers/index.js",
    "./UI/index.js": "./UI/index.js",
    "./UI/frontend/*": "./UI/frontend/*",
    "./UI/qxui/*": "./UI/qxui/*",
    "./UI/shroomui/*": "./UI/shroomui/*",
    "./UI/render/*": "./UI/render/*",

    "./src/*.js": "./src/*.js",
    "./src/*": "./src/*.js"
  },
  "files": [
    "index.js",
    "src",
    "UI/index.js",
    "UI/package.json",
    "UI/qxui",
    "UI/render",
    "UI/shroomui",
    "UI/frontend/index.js",
    "UI/frontend/package.json",
    "UI/frontend/core",
    "UI/frontend/renderers",
    "UI/frontend/styles",
    "examples",
    "!UI/render/prototypes",
    "!UI/**/node_modules",
    "!UI/**/node_modules/**",
    "!UI/**/dist",
    "!UI/**/dist/**",
    "!UI/**/.vite",
    "!UI/**/.vite/**",
    "!UI/**/*.test.js",
    "!UI/frontend/docs",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs && pnpm test:types && pnpm test:renderers && node -e \"require('./index'); console.log('SDK loaded')\"",
    "test:renderers": "vitest run UI/frontend/core UI/frontend/renderers",
    "test:types": "tsc --noEmit --jsx react-jsx --esModuleInterop --allowSyntheticDefaultImports --moduleResolution bundler --module preserve --target ES2020 --skipLibCheck UI/render/TerrainMapPage.tsx tests/render-public-types.ts",
    "sdk:demo": "node examples/backend-sdk-demo.js",
    "sdk:serial-demo": "node examples/serial-chain-demo.js",
    "demo:backend": "node examples/backend-sdk-demo.js",
    "demo:serial": "node examples/serial-chain-demo.js",
    "docs:dev": "vitepress dev docs --host 127.0.0.1",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1"
  },
  "dependencies": {
    "@serialport/parser-delimiter": "^13.0.0",
    "better-sqlite3": "^11.10.0",
    "csv-writer": "^1.6.0",
    "serialport": "^12.0.0",
    "ws": "^8.14.2"
  },
  "peerDependencies": {
    "@ant-design/icons": "^5.0.0",
    "@react-three/drei": "^9.0.0 || ^10.0.0",
    "@react-three/fiber": "^8.0.0 || ^9.0.0",
    "antd": "^5.0.0",
    "i18next": "^24.0.0 || ^25.0.0 || ^26.0.0",
    "mobx": "^6.0.0",
    "mobx-react": "^9.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-i18next": "^14.0.0 || ^15.0.0",
    "sass": "^1.0.0",
    "styled-components": "^6.0.0",
    "three": ">=0.152.0"
  },
  "peerDependenciesMeta": {
    "@ant-design/icons": {
      "optional": true
    },
    "antd": {
      "optional": true
    },
    "mobx": {
      "optional": true
    },
    "mobx-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-i18next": {
      "optional": true
    },
    "i18next": {
      "optional": true
    },
    "sass": {
      "optional": true
    },
    "styled-components": {
      "optional": true
    },
    "@react-three/drei": {
      "optional": true
    },
    "@react-three/fiber": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ant-design/icons": "^5.6.1",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.170.0",
    "antd": "^5.29.3",
    "i18next": "^24.2.3",
    "mobx": "^6.16.1",
    "mobx-react": "^9.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.7.4",
    "sass": "^1.102.0",
    "styled-components": "^6.5.1",
    "three": "^0.170.0",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.9"
  }
}
