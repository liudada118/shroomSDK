{
  "name": "shroom-sdk",
  "version": "0.2.0",
  "description": "Shroom 产品 SDK：取数、WS、分区渲染、带标签录制与下载",
  "type": "module",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/web/index.js"
    },
    "./web": {
      "types": "./src/index.d.ts",
      "default": "./src/web/index.js"
    },
    "./node": {
      "types": "./src/node/index.d.ts",
      "default": "./src/node/index.js"
    },
    "./quick-flow": {
      "types": "./src/quick-flow.d.ts",
      "default": "./src/quick-flow.js"
    },
    "./backend": {
      "types": "./src/backend/client.d.ts",
      "browser": "./src/backend/client.js",
      "node": "./src/node/backend.js",
      "default": "./src/backend/client.js"
    },
    "./core": {
      "types": "./src/core/frame.d.ts",
      "default": "./src/core/frame.js"
    }
  },
  "scripts": {
    "generate:examples": "node examples/generate-product-examples.mjs",
    "start": "node scripts/start.mjs",
    "demo": "node examples/node/demo.js",
    "ports": "node examples/node/demo.js --list",
    "demo:backend": "node examples/node/backend-demo.js",
    "demo:quick": "node examples/node/quick-demo.js",
    "demo:quick:mock": "node examples/node/quick-demo.js --mock",
    "test:backend": "node --test tests/backend-client.test.mjs",
    "build:sdk-bundle": "node scripts/build-sdk-bundle.mjs",
    "build": "npm run build:sdk-bundle && npm run generate:examples",
    "test": "npm run test:sdk && npm run test:types && npm run test:release",
    "test:sdk": "npm run build:sdk-bundle && node --test tests/*.test.mjs",
    "test:types": "tsc --noEmit",
    "test:python": "node scripts/sdk-python-tests.mjs",
    "test:release": "node --test scripts/tests/*.test.mjs",
    "sdk:version": "node scripts/sdk-version.mjs",
    "sdk:check": "node scripts/sdk-check.mjs",
    "sdk:verify": "node scripts/sdk-verify.mjs",
    "sdk:release": "node scripts/sdk-release.mjs",
    "pack:sdk": "npm run sdk:check && npm run build && node scripts/pack-sdk.mjs && node scripts/sdk-release-artifacts.mjs verify-latest",
    "pack:npm": "npm run sdk:check && node scripts/pack-npm.mjs",
    "test:npm": "npm run pack:npm && node scripts/check-npm-package.mjs",
    "test:npm:registry": "node scripts/check-npm-package.mjs --from-registry",
    "prepack": "node scripts/npm-source-guard.mjs"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0",
    "serialport": "^12.0.0",
    "ws": "^8.14.2"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "private": true,
  "packageManager": "npm@10.9.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liudada118/shroomSDK.git"
  },
  "homepage": "https://github.com/liudada118/shroomSDK#readme",
  "bugs": {
    "url": "https://github.com/liudada118/shroomSDK/issues"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "esbuild": "0.27.3",
    "typescript": "5.9.3"
  }
}
